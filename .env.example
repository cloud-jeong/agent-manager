# Backend (read by backend/app/config.py; prefix AGENT_MANAGER_)
AGENT_MANAGER_DATABASE_URL=postgresql+asyncpg://agent_manager:agent_manager@localhost:5433/agent_manager
# Database used by pytest (created by docker/init-test-db.sql)
AGENT_MANAGER_TEST_DATABASE_URL=postgresql+asyncpg://agent_manager:agent_manager@localhost:5433/agent_manager_test
# Secret used to sign JWT access tokens
AGENT_MANAGER_JWT_SECRET=dev-only-secret-change-me-in-production
# Access token lifetime in minutes
AGENT_MANAGER_JWT_EXPIRE_MINUTES=720
# Comma-separated list of allowed CORS origins
AGENT_MANAGER_CORS_ORIGINS=http://localhost:3000

# Frontend
# Host port for the frontend container (docker compose); change it if 3000 is taken
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
